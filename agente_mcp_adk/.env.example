# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL de Neon (connection string) — historial y agente de operaciones (opcional)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
HISTORY_LIMIT=10

# Qdrant — RAG (opcional, dejar vacío para deshabilitar)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# Neon MCP — base de datos vía MCP (opcional, dejar vacío para deshabilitar)
NEON_API_KEY=
# Opcional: id del proyecto de Neon para que el agente no vea otros proyectos
NEON_PROJECT_ID=
# true = solo lectura (recomendado). false = permite escribir, con aprobación humana en cada escritura
NEON_READONLY=true
